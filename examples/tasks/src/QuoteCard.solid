<script>
  import Panel from './Panel.solid';
  import { fetchQuote } from './quotes.ts';

  let index = $signal(0);
  let failing = $signal(false);

  // An async memo. Reading it inside #loading waits for the promise.
  const quote = $memo(fetchQuote(index, failing));
</script>
<style>
  blockquote {
    margin: 0;
    font-size: 1.25rem;
    transition: opacity 200ms;
    animation: appear 400ms ease-out;
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  cite {
    display: block;
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .placeholder,
  .error {
    margin: 0;
    color: var(--muted);
  }

  .error {
    color: #ef4444;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
  }

  button {
    padding: 0.5rem 0.75rem;
    border: none;
    border-radius: 0.5rem;
    color: var(--on-accent);
    background: var(--accent);
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.5;
  }
</style>
<!-- Panel renders a <figure> here instead of a <section>. -->
<Panel as="figure">
  #try {
    #loading {
      <!-- #key creates the quote again when it changes, which replays the animation. -->
      #key (quote) {
        <!-- $isPending is true while a new quote loads and the old one is still shown. -->
        <blockquote style={ opacity: $isPending(quote) ? 0.5 : 1 }>
          {quote.text}
          <cite>{quote.author}</cite>
        </blockquote>
      }
      <div class="actions">
        <button type="button" disabled=$isPending(quote) onClick=(() => index++)>Next quote</button>
        <button type="button" disabled=$isPending(quote) onClick=(() => failing = true)>
          Break the server
        </button>
      </div>
    } #else {
      <p class="placeholder">Loading a quote…</p>
    }
  } #catch (error, reset) {
    <script>
      function retry() {
        failing = false;
        reset();
      }
    </script>
    <p class="error">{error instanceof Error ? error.message : String(error)}</p>
    <div class="actions">
      <button type="button" onClick=retry>Try again</button>
    </div>
  }
</Panel>
