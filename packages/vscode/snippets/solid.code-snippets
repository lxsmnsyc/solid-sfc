{
  "if": {
    "prefix": "#if",
    "description": "Render markup when a condition is true",
    "body": ["#if (${1:condition}) {", "\t$0", "}"],
  },
  "if else": {
    "prefix": "#ifelse",
    "description": "Render one of two bodies",
    "body": ["#if (${1:condition}) {", "\t$2", "} #else {", "\t$0", "}"],
  },
  "for": {
    "prefix": "#for",
    "description": "Render markup for each item of a list",
    "body": ["#for (${1:item} of ${2:list}) {", "\t$0", "}"],
  },
  "for by key": {
    "prefix": "#forby",
    "description": "Render markup for each item of a list, keyed by a property",
    "body": ["#for (${1:item} of ${2:list} by ${1:item}.${3:id}) {", "\t$0", "}"],
  },
  "repeat": {
    "prefix": "#repeat",
    "description": "Render markup a number of times",
    "body": ["#repeat (${1:index} of ${2:count}) {", "\t$0", "}"],
  },
  "switch": {
    "prefix": "#switch",
    "description": "Render the first case whose condition is true",
    "body": [
      "#switch {",
      "\t#case (${1:condition}) {",
      "\t\t$2",
      "\t}",
      "\t#default {",
      "\t\t$0",
      "\t}",
      "}",
    ],
  },
  "try": {
    "prefix": "#try",
    "description": "Render a fallback when the body throws",
    "body": ["#try {", "\t$1", "} #catch (${2:error}, ${3:reset}) {", "\t$0", "}"],
  },
  "loading": {
    "prefix": "#loading",
    "description": "Render a fallback while the body loads",
    "body": ["#loading {", "\t$1", "} #else {", "\t$0", "}"],
  },
  "key": {
    "prefix": "#key",
    "description": "Render the body again when a value changes",
    "body": ["#key (${1:value}) {", "\t$0", "}"],
  },
  "portal": {
    "prefix": "#portal",
    "description": "Render markup at the end of the document body",
    "body": ["#portal {", "\t$0", "}"],
  },
  "reveal": {
    "prefix": "#reveal",
    "description": "Control the order in which loading blocks show their content",
    "body": ["#reveal ('${1|sequential,together,natural|}') {", "\t$0", "}"],
  },
  "template": {
    "prefix": "#template",
    "description": "Declare markup that the file can render with arguments",
    "body": ["#template ${1:name}(${2:params}) {", "\t$0", "}"],
  },
  "script": {
    "prefix": "script",
    "description": "A TypeScript script block",
    "body": ["<script lang=\"ts\">", "\t$0", "</script>"],
  },
  "style": {
    "prefix": "style",
    "description": "A scoped style block",
    "body": ["<style>", "\t$0", "</style>"],
  },
  "component": {
    "prefix": "component",
    "description": "A component with props, a style and markup",
    "body": [
      "<script lang=\"ts\">",
      "\tinterface Props {",
      "\t\t${1:label}: ${2:string};",
      "\t}",
      "",
      "\tconst { ${1:label} } = \\$props<Props>();",
      "</script>",
      "",
      "<style>",
      "\t${3:div} {",
      "\t}",
      "</style>",
      "",
      "<${3:div}>{${1:label}}</${3:div}>",
      "$0",
    ],
  },
}
