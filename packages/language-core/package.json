{
  "name": "@solid-sfc/language-core",
  "version": "1.0.1",
  "description": "Volar language plugin for solid-sfc",
  "keywords": [
    "sfc",
    "solid-js",
    "volar"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-sfc/tree/main/packages/language-core",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-sfc/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/solid-sfc.git",
    "directory": "packages/language-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
