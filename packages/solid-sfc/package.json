{
  "name": "solid-sfc",
  "version": "1.0.1",
  "description": "Single-file components for SolidJS",
  "keywords": [
    "sfc",
    "solid-js",
    "vite-plugin"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-sfc/tree/main/packages/solid-sfc",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-sfc/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/solid-sfc.git",
    "directory": "packages/solid-sfc"
  },
  "files": [
    "dist",
    "client.d.ts",
    "globals.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "default": "./dist/rolldown.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "default": "./dist/rspack.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@solidjs/compiler": "^2.0.0-rc.21",
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.157.0",
    "oxc-transform": "^0.157.0",
    "postcss": "^8.5.32",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.7",
    "unplugin": "^3.7.0"
  },
  "devDependencies": {
    "@oxc-project/types": "^0.157.0",
    "@rspack/core": "2.3.1",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.21",
    "@types/node": "^24.0.0",
    "@types/postcss-less": "^4.0.7",
    "esbuild": "0.28.2",
    "eslint-scope": "^9.1.2",
    "fast-check": "^4.10.2",
    "rolldown": "1.3.0",
    "rollup": "4.68.0",
    "solid-js": "2.0.0-rc.21",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "webpack": "5.112.2"
  },
  "peerDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.57",
    "@solidjs/web": "^2.0.0-rc.21",
    "solid-js": "^2.0.0-rc.21",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/vite-plugin": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
