{
  "name": "solid-sfc",
  "version": "0.2.0",
  "description": "Single-file components for SolidJS",
  "keywords": [
    "sfc",
    "solid-js",
    "vite-plugin"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-sfc/tree/main/packages/solid-sfc",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-sfc/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/solid-sfc.git",
    "directory": "packages/solid-sfc"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.154.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.17",
    "solid-labels": "^0.17.0",
    "solid-styled": "^0.12.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@babel/core": "^7.25.0",
    "solid-js": "^1.9.0",
    "solid-labels": "^0.17.0",
    "solid-styled": "^0.12.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "solid-labels": {
      "optional": true
    },
    "solid-styled": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-solid": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
