exports[`$ > captures setters in statements 1`] = `
"import { createSignal as _createSignal, createEffect as _createEffect } from 'solid-js';

let [count, setCount] = _createSignal(0);
_createEffect(() => [setCount], effectCallback);

function effectCallback([setCount]) {
  setCount(current => current += step());
}
"
`;

exports[`$ > stays inline when the statement writes plain outer variables 1`] = `
"import { createSignal as _createSignal, createEffect as _createEffect } from 'solid-js';

function App() {
  let el;
  let [count, setCount] = _createSignal(0);
  _createEffect(() => [count()], ([count]) => { el = render(count); });
}
"
`;

exports[`$ > transforms declarations into memos 1`] = `
"import { createSignal as _createSignal, createMemo as _createMemo } from 'solid-js';

let [count, setCount] = _createSignal(0);
const message = _createMemo(() => \`Count: \${count()}\`);
"
`;

exports[`$ > transforms statements like $effect 1`] = `
"import { createSignal as _createSignal, createEffect as _createEffect } from 'solid-js';

let [count, setCount] = _createSignal(0);
_createEffect(() => [count()], effectCallback);

function effectCallback([count]) {
  console.log(count);
}
"
`;

exports[`$memo > adds debug names in dev mode 1`] = `
"import { createMemo as _createMemo } from 'solid-js';
const value = _createMemo(() => compute(), { name: "value" });"
`;

exports[`$memo > adds debug names in dev mode 2`] = `
"import { createMemo as _createMemo } from 'solid-js';
const value = _createMemo(() => compute(), Object.assign({ name: "value" }, { lazy: true }));"
`;

exports[`$memo > supports refs 1`] = `
"import { createMemo as _createMemo } from 'solid-js';

const message = _createMemo(() => compute());
const accessor = message;
const getter = message;
const wrapped = { get message() { return message(); } };
"
`;

exports[`$memo > transforms declarations 1`] = `
"import { createSignal as _createSignal, createMemo as _createMemo } from 'solid-js';

let [count, setCount] = _createSignal(0);
const message = _createMemo(() => \`Count: \${count()}\`);
console.log(message());
"
`;

exports[`$memo > transforms declarations 2`] = `
"import { createMemo as _createMemo } from 'solid-js';
const value = _createMemo(() => compute());"
`;

exports[`$memo > transforms declarations 3`] = `
"import { createMemo as _createMemo } from 'solid-js';
