exports[`$component > destructures object-pattern props 1`] = `
"
const App = (props) => {
  const name = () => props.name,
    def = 0,
    count = () => { const value = props.count; return value === void 0 ? def : value; };
  return <div>{name()}: {count()}</div>;
};
"
`;

exports[`$component > leaves plain parameters alone 1`] = `
