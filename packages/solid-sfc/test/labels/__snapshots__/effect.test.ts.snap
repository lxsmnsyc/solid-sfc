// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`$effect > captures outer identifiers and hoists the callback 1`] = `
"import { createSignal as _createSignal, createEffect as _createEffect } from 'solid-js';

function App() {
  let [bar, setBar] = _createSignal(() => someValue());
  _createEffect(() => [bar()], AppEffect);
}

function AppEffect([bar]) {
    foo(bar);
  }
"
`;

exports[`$effect > captures setters for writes 1`] = `
"import { createSignal as _createSignal, createEffect as _createEffect } from 'solid-js';

function App() {
  let [count, setCount] = _createSignal(0);
  _createEffect(() => [setCount], AppEffect);
  _createEffect(() => [count(), setCount], AppEffect_1);
}

function AppEffect([setCount]) {
    setCount(current => current += 1);
  }

function AppEffect_1([count, setCount]) {
    setCount(() => compute(count));
  }
"
`;

exports[`$effect > captures signals, memos and plain locals 1`] = `
"import { createSignal as _createSignal, createMemo as _createMemo, createEffect as _createEffect } from 'solid-js';

function App(props) {
  let [count, setCount] = _createSignal(0);
  const message = _createMemo(() => \`Count: \${count()}\`);
  const step = props.step;
  _createEffect(() => [message(), count(), step], AppEffect);
}

function AppEffect([message, count, step]) {
    render(message, count, step);
  }
"
`;

exports[`$effect > combines $untrack reads with writes to the same signal 1`] = `
"import { createSignal as _createSignal, untrack as _untrack, createEffect as _createEffect } from 'solid-js';

function App() {
  let [count, setCount] = _createSignal(0);
  let [flag, setFlag] = _createSignal(false);
  _createEffect(() => [flag(), count, setCount], AppEffect);
}

function AppEffect([flag, count, setCount]) {
    if (flag) {
      setCount(() => _untrack(() => count()) + 1);
    }
  }
"
`;

exports[`$effect > does not capture module-scope plain values 1`] = `
"import { createSignal as _createSignal, createEffect as _createEffect } from 'solid-js';

const CONFIG = { step: 1 };
let [count, setCount] = _createSignal(0);
_createEffect(() => [count()], effectCallback);

function effectCallback([count]) {
  advance(count, CONFIG.step);
}
"
`;

exports[`$effect > excludes $untrack reads from the tracked source list 1`] = `
"import { createSignal as _createSignal, untrack as _untrack, createEffect as _createEffect } from 'solid-js';

function App() {
  let [count, setCount] = _createSignal(0);
  let [other, setOther] = _createSignal(0);
  _createEffect(() => [other(), count], AppEffect);
  _createEffect(() => [count], AppEffect_1);
}

function AppEffect([other, count]) {
    log(other, _untrack(() => count()));
  }

function AppEffect_1([count]) {
  log(_untrack(() => count()));
}
"
`;

exports[`$effect > hoists multiple callbacks in order 1`] = `
