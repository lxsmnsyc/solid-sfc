exports[`$effect > preserves a returned cleanup function 1`] = `
"import { createSignal as _createSignal, createEffect as _createEffect } from 'solid-js';

function App() {
  let [count, setCount] = _createSignal(0);
  _createEffect(() => [count()], AppEffect);
}

function AppEffect([count]) {
    const id = setInterval(() => poll(), count);
    return () => clearInterval(id);
  }
"
`;

exports[`$effect > stays inline when the callback uses this 1`] = `
