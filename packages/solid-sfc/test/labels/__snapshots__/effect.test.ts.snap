exports[`$effect > names hoisted callbacks after the nearest named scope 1`] = `
"import { createSignal as _createSignal, createEffect as _createEffect } from 'solid-js';

const Counter = (props) => {
  let [count, setCount] = _createSignal(0);
  _createEffect(() => [count()], CounterEffect);
  return null;
};

const helpers = {
  setup() {
    let [count, setCount_1] = _createSignal(0);
    _createEffect(() => [count()], setupEffect);
  },
};

function App() {
  function inner() {
    let [count, setCount_2] = _createSignal(0);
    _createEffect(() => [count()], innerEffect);
  }
}

let [top, setTop] = _createSignal(0);
_createEffect(() => [top()], effectCallback);

function CounterEffect([count]) {
    log(count);
  }

function setupEffect([count]) {
      log(count);
    }

function innerEffect([count]) {
  log(count);
}

function effectCallback([top]) {
  log(top);
}
"
`;

exports[`$effect > passes options through 1`] = `
