exports[`$effect > tracks and writes the same signal in one callback 1`] = `
"import { createSignal as _createSignal, createEffect as _createEffect } from 'solid-js';

function App() {
  let [count, setCount] = _createSignal(0);
  _createEffect(() => [count(), setCount], AppEffect);
