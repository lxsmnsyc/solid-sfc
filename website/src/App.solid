<script>
  import { lazy } from 'solid-js';
  import { version } from '../../packages/solid-sfc/package.json';
  import { href, path } from './router.ts';
  import Docs from './pages/Docs.solid';
  import Home from './pages/Home.solid';
  import Icon from './ui/Icon.solid';
  import Logo from './ui/Logo.solid';

  // The playground loads the compiler, so it is a separate chunk.
  const Playground = lazy(() => import('./pages/Playground.solid'));

  const REPOSITORY = 'https://github.com/lxsmnsyc/solid-sfc';

  const section = $memo(
    path().startsWith('/docs') ? 'docs' : path().startsWith('/playground') ? 'playground' : 'home',
  );

  // main.ts sets the saved theme before the first render. Dark is the default.
  let theme = $signal(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

  const themeLabel = $memo(theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');

  function toggleTheme(): void {
    // Writes to `theme` are batched, so reading it back here gives the old value.
    const next = theme === 'dark' ? 'light' : 'dark';
    theme = next;
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be off; the choice then lasts for this page only.
    }
  }
</script>

<style global>
  /*
   * Tokens of contracts/web-design.md v4. Each color holds its light and dark
   * value; `color-scheme` on the root picks one. Dark is the default.
   */
  :root {
    color-scheme: dark;

    --bg: light-dark(#f7f8fb, #070a12);
    --bg-raised: light-dark(#ffffff, #0c111c);
    --panel: light-dark(rgb(10 20 40 / 0.03), rgb(255 255 255 / 0.03));
    --border: light-dark(rgb(10 20 40 / 0.08), rgb(255 255 255 / 0.08));
    --border-strong: light-dark(rgb(10 20 40 / 0.16), rgb(255 255 255 / 0.16));
    --text: light-dark(#0b1220, #e8edf6);
    --muted: light-dark(#556072, #8a95a8);
    --faint: light-dark(#9aa3b2, #4b5567);
    --accent: light-dark(#2f5fd0, #5b8def);
    --accent-strong: light-dark(#1f4cb8, #7ea6ff);
    --accent-ink: light-dark(#ffffff, #050810);
    --glow: light-dark(rgb(47 95 208 / 0.18), rgb(68 107 158 / 0.45));
    --script: light-dark(#2f5fd0, #7ea6ff);
    /* #bd3f0b, not #c2410c: it stays at 4.5:1 or more on raised panels. */
    --style: light-dark(#bd3f0b, #ff8f6b);
    --markup: light-dark(#0f766e, #4fe0b8);
    --note: light-dark(#2f5fd0, #7ea6ff);
    --tip: light-dark(#0f766e, #4fe0b8);
    --important: light-dark(#7a3fc0, #c9a2ff);
    --warning: light-dark(#8a5a00, #f2c14e);
    --caution: light-dark(#b42318, #ff7a7a);

    /* The one floating object (the hero window) and the atmosphere. */
    --shadow: light-dark(rgb(16 24 40 / 0.12), rgb(0 0 0 / 0.55));
    --grid-line: light-dark(rgb(10 20 40 / 0.055), rgb(255 255 255 / 0.04));

    --font-display: 'Geist', system-ui, sans-serif;
    --font-body: 'Geist', system-ui, sans-serif;
    --font-mono: 'Geist Mono', ui-monospace, monospace;

    --step--1: clamp(0.8125rem, 0.79rem + 0.1vw, 0.875rem);
    --step-0: clamp(1rem, 0.97rem + 0.15vw, 1.0625rem);
    --step-1: clamp(1.125rem, 1.06rem + 0.3vw, 1.3125rem);
    --step-2: clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem);
    --step-3: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem);
    --step-4: clamp(2.25rem, 1.6rem + 3vw, 4rem);
    --step-5: clamp(2.5rem, 1.5rem + 4.6vw, 5.5rem);
    --step-6: clamp(3.25rem, 1.6rem + 7.5vw, 7rem);

    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --space-6: 2rem;
    --space-7: 3rem;
    --space-8: clamp(3.5rem, 2.5rem + 4vw, 5rem);
    --space-9: clamp(5rem, 3rem + 8vw, 9rem);

    --radius: 12px;
    --radius-sm: 8px;
    /* For elements inside a --radius-sm or --radius box, so corners nest. */
    --radius-xs: 4px;
    --grid-max: 80rem;
    --gutter: clamp(1rem, 4vw, 2.5rem);
    --measure: 68ch;
    --header-height: 3.75rem;
    /* Entrances ease out over 200ms; exits ease in over 150ms. */
    --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
    --ease-in: cubic-bezier(0.4, 0, 1, 1);
    --enter: 200ms;
    --exit: 150ms;
    --ease: var(--ease-out);

    /* Old names, kept until every page has moved. web-og-image removes them. */
    --background: var(--bg);
    --surface: var(--bg-raised);
    --code-background: var(--bg-raised);
    --accent-text: var(--accent-ink);
    --font: var(--font-body);
    --mono: var(--font-mono);
  }

  :root[data-theme='light'] {
    color-scheme: light;
  }

  *,
  ::before,
  ::after {
    box-sizing: border-box;
  }

  html {
    scroll-padding-top: calc(var(--header-height) + var(--space-5));
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
  }

  #app {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  ::selection {
    background: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family: var(--font-display);
    text-wrap: balance;
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  h2 {
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  h3 {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  h4 {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  p {
    text-wrap: pretty;
  }

  strong,
  b {
    font-weight: 600;
  }

  a {
    color: var(--accent-strong);
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  :focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  code,
  kbd,
  pre,
  samp,
  textarea {
    font-family: var(--font-mono);
    font-variant-ligatures: none;
  }

  :not(pre) > code {
    padding: 0.125em 0.375em;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    font-size: 0.875em;
    background: var(--panel);
  }

  pre.twinkleplop {
    overflow-x: auto;
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.8125rem;
    line-height: 1.7;
    tab-size: 2;
    background: var(--bg-raised);
    scrollbar-color: var(--border-strong) transparent;
    scrollbar-width: thin;
  }

  /* A raised panel: one border on the raised background, nothing more. */
  .raised {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .button {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font: 500 0.9375rem / 1 var(--font-body);
    letter-spacing: -0.005em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--text);
    background: var(--panel);
    cursor: pointer;
    transition: transform var(--exit) var(--ease-in);
  }

  .button:hover {
    border-color: var(--faint);
    background: var(--border);
  }

  /* Press feedback for every control: a quick scale down. */
  :is(.button, button):active:not(:disabled) {
    transform: scale(0.97);
    transition: transform 100ms var(--ease-out);
  }

  .button.primary {
    border-color: transparent;
    color: var(--accent-ink);
    background: var(--accent);
  }

  .button.primary:hover {
    background: var(--accent-strong);
  }

  .button .arrow {
    display: inline-flex;
    transition: transform var(--exit) var(--ease-in);
  }

  .button:hover .arrow {
    transform: translateX(3px);
    transition: transform var(--enter) var(--ease-out);
  }

  :is(.button, button):disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .kbd {
    display: inline-flex;
    align-items: center;
    min-width: 1.5em;
    height: 1.5em;
    padding: 0 0.375em;
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: var(--radius-xs);
    font: 500 0.75rem / 1 var(--font-mono);
    color: var(--muted);
    background: var(--panel);
  }

  /* Mono label. `data-block` gives it the hue of a block. */
  .label {
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    font: 500 0.75rem / 1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .label[data-block='script'] {
    color: var(--script);
  }

  .label[data-block='style'] {
    color: var(--style);
  }

  .label[data-block='markup'] {
    color: var(--markup);
  }

  .label[data-block]::before {
    content: '';
    width: 0.5em;
    height: 0.5em;
    border-radius: 2px;
    background: currentColor;
    box-shadow: 0 0 10px currentColor;
  }

  /* 12 columns inside --grid-max, with --gutter on both sides. */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-5);
    width: 100%;
    max-width: calc(var(--grid-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    ::before,
    ::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<style>
  .skip {
    position: fixed;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 30;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent-ink);
    background: var(--accent);
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  /* Atmosphere: a glow and a fading 32px grid behind the page. */
  .atmosphere {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 76rem;
    overflow: hidden;
    pointer-events: none;
  }

  .atmosphere.docs {
    height: 34rem;
    opacity: 0.55;
  }

  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(64rem 40rem at 50% 12rem, var(--glow), transparent 70%),
      radial-gradient(
        28rem 22rem at 16% 52rem,
        color-mix(in srgb, var(--style) 9%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30rem 24rem at 86% 46rem,
        color-mix(in srgb, var(--markup) 9%, transparent),
        transparent 70%
      );
  }

  .lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-position: center top;
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(70rem 44rem at 50% 0, #000 20%, transparent 75%);
    mask-image: radial-gradient(70rem 44rem at 50% 0, #000 20%, transparent 75%);
  }


  header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-height);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
  }

  .bar {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    max-width: calc(var(--grid-max) + 2 * var(--gutter));
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* The playground fills the window, so its bar does too. */
  .bar.wide {
    max-width: none;
    padding-inline: var(--space-5);
  }

  .brand {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-right: var(--space-2);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--text);
  }

  .version {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font: 500 0.6875rem / 1.5 var(--font-mono);
    text-decoration: none;
    color: var(--muted);
    background: var(--panel);
  }

  .version:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .main-nav {
    display: flex;
    gap: var(--space-1);
    margin-left: var(--space-5);
  }

  .main-nav a {
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--muted);
  }

  .main-nav a:hover {
    color: var(--text);
    background: var(--panel);
  }

  .main-nav a[aria-current='page'] {
    color: var(--text);
    background: var(--border);
  }

  .actions {
    display: flex;
    gap: var(--space-1);
    margin-left: auto;
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--muted);
    background: none;
    cursor: pointer;
  }

  .icon-button:hover {
    color: var(--text);
    background: var(--panel);
  }

  /* Touch needs 44px targets, even where the visible part is smaller. */
  @media (pointer: coarse) {
    .icon-button {
      width: 2.75rem;
      height: 2.75rem;
    }

    .main-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }

  #content {
    flex: 1;
  }

  #content:focus {
    outline: none;
  }

  footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--border);
    background: linear-gradient(var(--panel), transparent 60%);
  }

  .footer {
    row-gap: var(--space-6);
    padding-block: var(--space-8) var(--space-6);
  }

  .about {
    grid-column: 1 / 6;
  }

  .about .brand {
    margin: 0;
  }

  .about p {
    max-width: 28ch;
    margin: var(--space-3) 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .links {
    grid-column: span 2;
  }

  .links:first-of-type {
    grid-column: 8 / span 2;
  }

  .links ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .links a,
  .fine a {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--muted);
  }

  .links a:hover,
  .fine a:hover {
    color: var(--text);
  }

  .fine {
    display: flex;
    grid-column: 1 / -1;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    justify-content: space-between;
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font: 400 0.75rem / 1.5 var(--font-mono);
    color: var(--muted);
  }

  .loading {
    width: 100%;
    max-width: calc(var(--grid-max) + 2 * var(--gutter));
    margin: 0 auto;
    padding: var(--space-8) var(--gutter);
  }

  @media (max-width: 48rem) {
    .about {
      grid-column: 1 / -1;
    }

    .links,
    .links:first-of-type {
      grid-column: span 6;
    }
  }

  @media (max-width: 40rem) {
    .version {
      display: none;
    }

    .main-nav {
      margin-left: 0;
    }

    .main-nav a {
      padding-inline: 0.5rem;
    }
  }

  @media (max-width: 26rem) {
    .bar .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>

<a class="skip" href="#content">Skip to content</a>

#if (section !== 'playground') {
  <div class={ atmosphere: true, docs: section === 'docs' } aria-hidden="true">
    <div class="glow" />
    <div class="lines" />
  </div>
}

<header>
  <div class={ bar: true, wide: section === 'playground' }>
    <a class="brand" href=href('/')>
      <Logo size=22 />
      <span class="brand-name">solid-sfc</span>
    </a>
    <a class="version" href=`${REPOSITORY}/releases` target="_blank" rel="noreferrer">
      v{version}
    </a>
    <nav class="main-nav" aria-label="Main">
      <a href=href('/docs') aria-current=(section === 'docs' ? 'page' : undefined)>Docs</a>
      <a href=href('/playground') aria-current=(section === 'playground' ? 'page' : undefined)>
        Playground
      </a>
    </nav>
    <div class="actions">
      <a
        class="icon-button"
        href=REPOSITORY
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
        title="GitHub"
      >
        <Icon name="github" size=20 />
      </a>
      <button
        type="button"
        class="icon-button"
        onClick=toggleTheme
        aria-label=themeLabel
        title=themeLabel
      >
        #if (theme === 'dark') {
          <Icon name="sun" size=20 />
        } #else {
          <Icon name="moon" size=20 />
        }
      </button>
    </div>
  </div>
</header>

<div id="content" tabindex="-1">
  #switch {
    #case (section === 'docs') {
      <Docs />
    }
    #case (section === 'playground') {
      #loading {
        <Playground />
      } #else {
        <p class="loading label">Loading the compiler…</p>
      }
    }
    #default {
      <Home />
    }
  }
</div>

#if (section !== 'playground') {
  <footer>
    <div class="grid footer">
      <div class="about">
        <a class="brand" href=href('/')>
          <Logo size=22 />
          <span>solid-sfc</span>
        </a>
        <p>Single-file components for SolidJS 2.0. Script, style and markup in one file.</p>
      </div>
      <nav class="links" aria-label="Documentation">
        <span class="label">Docs</span>
        <ul>
          <li><a href=href('/docs/getting-started')>Getting started</a></li>
          <li><a href=href('/docs/components')>Components</a></li>
          <li><a href=href('/docs/control-flow')>Control flow</a></li>
          <li><a href=href('/docs/styles')>Styles</a></li>
        </ul>
      </nav>
      <nav class="links" aria-label="Project">
        <span class="label">Project</span>
        <ul>
          <li><a href=href('/playground')>Playground</a></li>
          <li><a href=REPOSITORY target="_blank" rel="noreferrer">GitHub</a></li>
          <li>
            <a href="https://www.npmjs.com/package/solid-sfc" target="_blank" rel="noreferrer">npm</a>
          </li>
          <li>
            <a
              href=`${REPOSITORY}/blob/main/packages/solid-sfc/CHANGELOG.md`
              target="_blank"
              rel="noreferrer"
            >
              Changelog
            </a>
          </li>
        </ul>
      </nav>
      <p class="fine">
        <span>MIT License</span>
        <span>v{version} · built with solid-sfc</span>
      </p>
    </div>
  </footer>
}
