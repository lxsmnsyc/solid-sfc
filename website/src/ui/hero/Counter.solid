<script>
  let count = $signal(0);
  const doubled = $memo(count * 2);
  const hot = $memo(count > 4);
</script>

<style>
  button {
    color: white;
    background: royalblue;
    scale: ${1 + Math.min(count, 8) / 40};
  }

  .hot {
    background: crimson;
  }
</style>

<button class={ hot } onClick=(() => count++)>
  Count is {count}
</button>

#if (hot) {
  <p>Doubled, that is {doubled}.</p>
}
