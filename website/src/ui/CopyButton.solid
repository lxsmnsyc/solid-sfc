<script>
  import Icon from './Icon.solid';

  interface Props {
    /** Reads the text to copy when the button is pressed. */
    text: () => string;
    /** Accessible name, which must start with "Copy". */
    label?: string;
    /** Visible text before the copy. Defaults to "Copy". */
    caption?: string;
  }

  const props = $props<Props>();
  let status = $signal<'idle' | 'copied' | 'failed'>('idle');
  let timer: ReturnType<typeof setTimeout> | undefined;

  async function copy(): Promise<void> {
    clearTimeout(timer);
    // Writes are batched, so the outcome is kept in a local, not read back.
    let next: 'copied' | 'failed' = 'copied';
    try {
      await navigator.clipboard.writeText(props.text());
    } catch {
      // The clipboard needs a secure context and permission.
      next = 'failed';
    }
    status = next;
    timer = setTimeout(() => (status = 'idle'), next === 'failed' ? 2400 : 1600);
  }

  $cleanup(() => clearTimeout(timer));
</script>

<style>
  button {
    display: inline-flex;
    flex: none;
    gap: 0.375rem;
    align-items: center;
    justify-content: center;
    height: 2rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    font: 500 0.75rem / 1 var(--font-body);
    color: var(--muted);
    background: var(--panel);
    cursor: pointer;
  }

  button:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  /* Every label sits in one cell, so the widest sets the width and the
     button never changes size. */
  .labels {
    display: grid;
  }

  .labels > span {
    display: inline-flex;
    grid-area: 1 / 1;
    gap: 0.375rem;
    align-items: center;
    justify-content: center;
    visibility: hidden;
  }

  .labels > .on {
    visibility: visible;
  }

  .copied {
    color: var(--markup);
  }

  .failed {
    color: var(--caution);
  }

  @media (pointer: coarse) {
    button {
      height: 2.75rem;
    }
  }
</style>

<button
  type="button"
  class={ copied: status === 'copied', failed: status === 'failed' }
  onClick=copy
  aria-label=props.label
>
  <span class="labels">
    <span class={ on: status === 'idle' }>
      <Icon name="copy" />
      {props.caption ?? 'Copy'}
    </span>
    <span class={ on: status === 'copied' }>
      <Icon name="check" />
      Copied
    </span>
    <span class={ on: status === 'failed' }>
      <Icon name="alert" />
      Failed
    </span>
  </span>
</button>
<span class="visually-hidden" aria-live="polite">
  {status === 'copied' ? 'Copied' : status === 'failed' ? "Couldn't copy" : ''}
</span>
