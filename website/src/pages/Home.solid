    line-height: 1.1;
  }

  .tagline {
    margin: 1.25rem 0 2rem;
    font-size: 1.2rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .install {
    margin-top: 1.5rem;
    color: var(--muted);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
    margin-top: 5rem;
  }

  .feature {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--surface);
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .feature p {
    margin: 0;
