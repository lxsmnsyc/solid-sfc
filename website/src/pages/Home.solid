<script>
  import example from '../content/example.md';
  import { href } from '../router.ts';

  const FEATURES = [
    {
      title: 'One file per component',
      text: 'A script, scoped styles and markup, in that order. The script runs once per instance, like the body of a Solid component.',
    },
    {
      title: 'Compile-time reactivity',
      text: '$signal, $memo and $effect read like plain variables. The compiler turns them into Solid 2.0 calls.',
    },
    {
      title: 'Control flow blocks',
      text: '#if, #for, #loading, #try and more compile to Solid components, with typed headers and fallbacks.',
    },
    {
      title: 'Scoped, reactive styles',
      text: 'Styles only match the elements of their file, and ${…} turns script values into CSS variables. SCSS and Less work too.',
    },
    {
      title: 'Typed everywhere',
      text: 'Volar tooling type-checks the markup, and the VS Code extension adds completion, folding and an outline.',
    },
    {
      title: 'Any bundler',
      text: 'Plugins for Vite, Rollup, Rolldown, webpack, Rspack and esbuild. Vite adds HMR, SSR and server functions.',
    },
  ];

  $effect(() => {
    document.title = 'solid-sfc: single-file components for SolidJS';
  });
</script>

