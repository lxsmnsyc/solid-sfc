    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<main>
  <section class="hero">
    <div>
      <h1>Single-file components for SolidJS</h1>
      <p class="tagline">
        Write a Solid 2.0 component as one <code>.solid</code> file, with reactive variables,
        control flow blocks and scoped styles.
      </p>
      <div class="actions">
        <a class="button primary" href=href('/docs/getting-started')>Get started</a>
        <a class="button" href=href('/playground')>Try the playground</a>
      </div>
      <p class="install"><code>npm install solid-sfc</code></p>
    </div>
    <div innerHTML=example.html />
  </section>

  <section class="features">
    #for (feature of FEATURES) {
      <div class="feature">
        <h2>{feature.title}</h2>
        <p>{feature.text}</p>
      </div>
    }
  </section>
</main>
