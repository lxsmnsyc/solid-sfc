<script>
  import { onCleanup } from 'solid-js';
  import { compile } from 'solid-sfc';
  import type { SFCWarning } from 'solid-sfc';
  import { Listbox, ListboxButton, ListboxOption, ListboxOptions } from 'terracotta/listbox';
  import { Tab as OutputTab, TabGroup, TabList, TabPanel } from 'terracotta/tabs';
  import { examples } from '../examples.ts';
  import { highlight } from '../highlight/index.ts';

  type Tab = 'preview' | 'tsx' | 'css' | 'warnings';
  type Output =
    | { ok: true; code: string; css: string; warnings: SFCWarning[] }
    | { ok: false; error: string };

  /** The source in the URL, so a link shares it. */
  function encode(text: string): string {
    const bytes = new TextEncoder().encode(text);
    return btoa(String.fromCharCode(...bytes));
  }

  function decode(hash: string): string | undefined {
    if (!hash) {
      return undefined;
    }
    try {
      const binary = atob(hash);
      return new TextDecoder().decode(Uint8Array.from(binary, (char) => char.charCodeAt(0)));
    } catch {
      return undefined;
    }
  }

  function run(code: string): Output {
    try {
      const result = compile(code, { filename: 'Playground.solid', scope: 'playground' });
      return { ok: true, code: result.code, css: result.css?.code ?? '', warnings: result.warnings };
    } catch (error) {
      return { ok: false, error: error instanceof Error ? error.message : String(error) };
    }
  }

  let source = $signal(decode(location.hash.slice(1)) ?? examples[0]!.source);
  let tab = $signal<Tab>('preview');
  let copied = $signal(false);
  const output = $memo(run(source));

  const highlighted = $memo(
    output.ok && (tab === 'tsx' || tab === 'css')
      ? highlight(tab === 'tsx' ? output.code : output.css || '/* No styles */', tab)
      : undefined,
  );
  // The editor is a textarea over the highlighted source. A trailing line
  // break keeps the last line of both the same height.
  const sourceHtml = $memo(highlight(`${source}\n`, 'solid'));
  let backdrop!: HTMLDivElement;

  function syncScroll(event: Event & { currentTarget: HTMLTextAreaElement }) {
    backdrop.scrollTop = event.currentTarget.scrollTop;
    backdrop.scrollLeft = event.currentTarget.scrollLeft;
  }

  $effect(() => {
    history.replaceState(null, '', `#${encode(source)}`);
  });

  // The preview compiles the JSX with WebAssembly compilers, which load
  // when the preview first opens, and runs the result in a frame.
  type Builder = typeof import('../preview/build.ts');
  let builder = $signal<Builder | undefined>(undefined);
  let frameReady = $signal(false);
  let previewError = $signal('');
  let frame: HTMLIFrameElement | undefined;
  const previewUrl = `${import.meta.env.BASE_URL}preview.html`;

  $effect(() => {
    if (tab === 'preview' && !builder) {
      void import('../preview/build.ts').then((module) => {
        builder = module;
      });
    }
  });

  function onMessage(event: MessageEvent) {
    if (event.source === frame?.contentWindow && event.data?.ready) {
      frameReady = true;
    }
  }
  addEventListener('message', onMessage);
  onCleanup(() => removeEventListener('message', onMessage));

  // Waits for a pause in typing before the preview runs the new code.
  let timer: ReturnType<typeof setTimeout> | undefined;
  $effect(() => {
    const result = output;
    const ready = tab === 'preview' && frameReady && builder;
    clearTimeout(timer);
    if (!ready || !result.ok) {
      return;
    }
    const build = builder!;
    timer = setTimeout(() => {
      try {
        const code = build.buildPreview(result.code);
        previewError = '';
        frame?.contentWindow?.postMessage({ code }, location.origin);
      } catch (error) {
        previewError = error instanceof Error ? error.message : String(error);
      }
    }, 250);
  });

  $effect(() => {
    document.title = 'Playground | solid-sfc';
  });

  // The example that the editor holds, until the source is edited.
  const selected = $memo(examples.find((item) => item.source === source)?.name);

  function load(name?: string) {
    const example = examples.find((item) => item.name === name);
    if (example) {
      source = example.source;
    }
  }

  const tabs: { value: Tab; label: string }[] = [
    { value: 'preview', label: 'Preview' },
    { value: 'tsx', label: 'TSX' },
    { value: 'css', label: 'CSS' },
    { value: 'warnings', label: 'Warnings' },
  ];

  async function share() {
    await navigator.clipboard.writeText(location.href);
    copied = true;
    setTimeout(() => (copied = false), 1500);
  }

  // Tab inserts two spaces instead of leaving the editor.
  function indent(event: KeyboardEvent & { currentTarget: HTMLTextAreaElement }) {
    if (event.key !== 'Tab' || event.shiftKey) {
      return;
    }
    event.preventDefault();
    const editor = event.currentTarget;
    const { selectionStart, selectionEnd } = editor;
    editor.setRangeText('  ', selectionStart, selectionEnd, 'end');
    source = editor.value;
  }
</script>

<style>
  main {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: calc(100vh - var(--header-height));
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 0.6rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Terracotta renders the picker and the tabs, so they are not scoped. */
  .toolbar :global(.picker) {
    position: relative;
  }

  .toolbar :global(.picker-button),
  .action {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    font: inherit;
    color: inherit;
    background: var(--surface);
    cursor: pointer;
  }

  .toolbar :global(.picker-button) {
    min-width: 12rem;
    justify-content: space-between;
  }

  .toolbar :global(.picker-options) {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    z-index: 20;
    min-width: 100%;
    max-height: 20rem;
    overflow-y: auto;
    margin: 0;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    list-style: none;
    background: var(--background);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.15);
  }

  .toolbar :global(.picker-option) {
    padding: 0.35rem 0.6rem;
    border-radius: 0.25rem;
    white-space: nowrap;
    cursor: pointer;
  }

  .toolbar :global(.picker-option[tc-active]) {
    background: var(--surface);
  }

  .toolbar :global(.picker-option[tc-selected]) {
    font-weight: 600;
    color: var(--accent);
  }

  .hint {
    margin-left: auto;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 0;
  }

  .editor {
    position: relative;
    min-height: 0;
    border-right: 1px solid var(--border);
    background: var(--background);
  }

  /* The textarea and the highlighted copy under it share their layout. */
  textarea,
  .backdrop :global(pre) {
    margin: 0;
    padding: 1rem 1.5rem;
    border: none;
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: pre;
    tab-size: 2;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* The frame scrolls with the textarea, so the copy must not scroll itself. */
  .backdrop :global(pre) {
    width: max-content;
    min-width: 100%;
    min-height: 100%;
    overflow: visible;
    border-radius: 0;
    background: none;
  }

  textarea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    color: transparent;
    caret-color: var(--text);
    background: none;
    resize: none;
    outline: none;
  }

  .panes > :global(.output) {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
    background: var(--surface);
  }

  .panes :global(.tabs) {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .panes :global(.tab) {
    padding: 0.4rem 0.75rem;
    border: none;
    border-bottom: 2px solid transparent;
    font: inherit;
    color: var(--muted);
    background: none;
    cursor: pointer;
  }

  .panes :global(.tab[tc-selected]) {
    border-bottom-color: var(--accent);
    color: var(--text);
  }

  /* An error replaces the panels until the code compiles. */
  .panes :global(.failed > [role='tabpanel']) {
    display: none;
  }

  pre {
    overflow: auto;
    margin: 0;
    padding: 1rem 1.5rem;
    line-height: 1.5;
  }

  .code {
    height: 100%;
    overflow: auto;
  }

  .code :global(pre.twinkleplop) {
    min-height: 100%;
    margin: 0;
    padding: 1rem 1.5rem;
    border: none;
    border-radius: 0;
    overflow: visible;
    background: none;
  }

  .panes :global(.panel) {
    min-height: 0;
    overflow: auto;
  }

  /* A panel that stays mounted is only shown with its tab. */
  .panes :global(.panel:not([tc-selected])) {
    display: none;
  }

  .panes :global(.preview) {
    display: flex;
    flex-direction: column;
  }

  /* The frame takes the space under the status line, if there is one. */
  iframe {
    flex: 1;
    width: 100%;
    border: none;
    background: white;
  }

  .status {
    margin: 0;
    padding: 0.5rem 1.5rem;
    color: var(--muted);
  }

  .error {
    color: #d33f49;
    white-space: pre-wrap;
  }

  .warnings {
    margin: 0;
    padding: 1rem 1.5rem 1rem 2.5rem;
  }

  .warnings code {
    color: var(--muted);
  }

  .count {
    margin-left: 0.25rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--accent-text);
    background: var(--accent);
  }

  @media (max-width: 48rem) {
    main {
      height: auto;
    }

    .panes {
      grid-template-columns: minmax(0, 1fr);
    }

    .editor {
      height: 24rem;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .hint {
      display: none;
    }
  }
</style>

<main>
  <div class="toolbar">
    <Listbox class="picker" value=selected onSelectChange=load defaultOpen=false>
      <ListboxButton class="picker-button" aria-label="Example">
        <span>{selected ?? 'Edited example'}</span>
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
          <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </ListboxButton>
      <ListboxOptions class="picker-options">
        #for (example of examples) {
          <ListboxOption class="picker-option" value=example.name>{example.name}</ListboxOption>
        }
      </ListboxOptions>
    </Listbox>
    <button type="button" class="action" onClick=share>
      #if (copied) {
        Link copied
      } #else {
        Copy link
      }
    </button>
    <span class="hint">The compiler runs in your browser.</span>
  </div>

  <div class="panes">
    <div class="editor">
      <div class="backdrop" ref=backdrop aria-hidden="true" innerHTML=sourceHtml />
      <textarea
        aria-label="Source"
        spellcheck=false
        value=source
        onInput=((event) => (source = event.currentTarget.value))
        onKeyDown=indent
        onScroll=syncScroll
      />
    </div>
    <TabGroup
      class={ output: true, failed: !output.ok }
      aria-label="Output"
      horizontal=true
      value=tab
      onChange=((value?: Tab) => {
        if (value) {
          tab = value;
        }
      })
    >
      <TabList class="tabs">
        #for (item of tabs) {
          <OutputTab as="button" type="button" class="tab" value=item.value>
            {item.label}
            #if (item.value === 'warnings' && output.ok && output.warnings.length > 0) {
              <span class="count">{output.ok ? output.warnings.length : 0}</span>
            }
          </OutputTab>
        }
      </TabList>
      #if (!output.ok) {
        <pre class="error">{output.ok ? '' : output.error}</pre>
      }
      <!-- The preview stays mounted, so its frame does not load again. -->
      <TabPanel class="panel preview" value="preview" unmount=false>
        #if (previewError) {
          <pre class="error">{previewError}</pre>
        } #else if (!builder) {
          <p class="status">Loading Solid's compiler…</p>
        }
        <!-- A new frame tells the playground when it is ready. -->
        <iframe
          title="Preview"
          src=previewUrl
          ref=((element: HTMLIFrameElement) => {
            frame = element;
            frameReady = false;
          })
        />
      </TabPanel>
      <TabPanel class="panel" value="tsx">
        #if (highlighted) {
          <div class="code" innerHTML=highlighted />
        } #else {
          <pre>{output.ok ? output.code : ''}</pre>
        }
      </TabPanel>
      <TabPanel class="panel" value="css">
        #if (highlighted) {
          <div class="code" innerHTML=highlighted />
        } #else {
          <pre>{output.ok ? output.css || '/* No styles */' : ''}</pre>
        }
      </TabPanel>
      <TabPanel class="panel" value="warnings">
        <ul class="warnings">
          #for (warning of output.ok ? output.warnings : []) {
            <li>{warning.line}:{warning.column} {warning.message} <code>{warning.code}</code></li>
          } #else {
            <li>No warnings.</li>
          }
        </ul>
      </TabPanel>
    </TabGroup>
  </div>
</main>
