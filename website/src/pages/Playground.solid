<script>
  import { onCleanup } from 'solid-js';
  import { compile } from 'solid-sfc';
  import type { SFCWarning } from 'solid-sfc';
  import { Listbox, ListboxButton, ListboxOption, ListboxOptions } from 'terracotta/listbox';
  import { Tab as OutputTab, TabGroup, TabList, TabPanel } from 'terracotta/tabs';
  import { examples } from '../examples.ts';
  import { highlight } from '../highlight/index.ts';
  import CopyButton from '../ui/CopyButton.solid';
  import Icon from '../ui/Icon.solid';

  type Tab = 'preview' | 'tsx' | 'css' | 'warnings';
  type Output =
    | { ok: true; code: string; css: string; warnings: SFCWarning[] }
    | { ok: false; error: string };

  /** The source in the URL, so a link shares it. */
  function encode(text: string): string {
    const bytes = new TextEncoder().encode(text);
    return btoa(String.fromCharCode(...bytes));
  }

  function decode(hash: string): string | undefined {
    if (!hash) {
      return undefined;
    }
    try {
      const binary = atob(hash);
      return new TextDecoder().decode(Uint8Array.from(binary, (char) => char.charCodeAt(0)));
    } catch {
      return undefined;
    }
  }

  function run(code: string): Output {
    try {
      const result = compile(code, { filename: 'Playground.solid', scope: 'playground' });
      return { ok: true, code: result.code, css: result.css?.code ?? '', warnings: result.warnings };
    } catch (error) {
      return { ok: false, error: error instanceof Error ? error.message : String(error) };
    }
  }

  let source = $signal(decode(location.hash.slice(1)) ?? examples[0]!.source);
  let tab = $signal<Tab>('preview');
  const output = $memo(run(source));

  const highlighted = $memo(
    output.ok && (tab === 'tsx' || tab === 'css')
      ? highlight(tab === 'tsx' ? output.code : output.css || '/* No styles */', tab)
      : undefined,
  );
  // The editor is a textarea over the highlighted source. A trailing line
  // break keeps the last line of both the same height.
  const sourceHtml = $memo(highlight(`${source}\n`, 'solid'));
  let backdrop!: HTMLDivElement;

  function syncScroll(event: Event & { currentTarget: HTMLTextAreaElement }) {
    backdrop.scrollTop = event.currentTarget.scrollTop;
    backdrop.scrollLeft = event.currentTarget.scrollLeft;
  }

  $effect(() => {
    history.replaceState(null, '', `#${encode(source)}`);
  });

  // The preview compiles the JSX with WebAssembly compilers, which load
  // when the preview first opens, and runs the result in a frame.
  type Builder = typeof import('../preview/build.ts');
  let builder = $signal<Builder | undefined>(undefined);
  let frameReady = $signal(false);
  let previewError = $signal('');
  let frame: HTMLIFrameElement | undefined;
  const previewUrl = `${import.meta.env.BASE_URL}preview.html`;

  $effect(() => {
    if (tab === 'preview' && !builder) {
      void import('../preview/build.ts').then((module) => {
        builder = module;
      });
    }
  });

  function onMessage(event: MessageEvent) {
    if (event.source === frame?.contentWindow && event.data?.ready) {
      frameReady = true;
    }
  }
  addEventListener('message', onMessage);
  onCleanup(() => removeEventListener('message', onMessage));

  // Waits for a pause in typing before the preview runs the new code.
  let timer: ReturnType<typeof setTimeout> | undefined;
  $effect(() => {
    const result = output;
    const ready = tab === 'preview' && frameReady && builder;
    clearTimeout(timer);
    if (!ready || !result.ok) {
      return;
    }
    const build = builder!;
    timer = setTimeout(() => {
      try {
        const code = build.buildPreview(result.code);
        previewError = '';
        frame?.contentWindow?.postMessage({ code }, location.origin);
      } catch (error) {
        previewError = error instanceof Error ? error.message : String(error);
      }
    }, 250);
  });

  $effect(() => {
    document.title = 'Playground | solid-sfc';
  });

  // The example that the editor holds, until the source is edited.
  const selected = $memo(examples.find((item) => item.source === source)?.name);

  // Loading an example replaces edited code, so it can be undone: with the
  // toast, or with Back, since each load is a new history entry.
  let undo = $signal<{ name: string; source: string } | undefined>(undefined);
  let undoTimer: ReturnType<typeof setTimeout> | undefined;

  function load(name?: string) {
    const example = examples.find((item) => item.name === name);
    if (!example || example.source === source) {
      return;
    }
    const before = source;
    const edited = !examples.some((item) => item.source === before);
    history.pushState(null, '', `#${encode(example.source)}`);
    source = example.source;
    clearTimeout(undoTimer);
    if (edited) {
      undo = { name: example.name, source: before };
      undoTimer = setTimeout(() => (undo = undefined), 6000);
    } else {
      undo = undefined;
    }
  }

  function restore() {
    if (undo) {
      history.back();
      undo = undefined;
    }
  }

  function onPopState() {
    const restored = decode(location.hash.slice(1));
    if (restored !== undefined) {
      source = restored;
    }
  }
  addEventListener('popstate', onPopState);
  onCleanup(() => {
    removeEventListener('popstate', onPopState);
    clearTimeout(undoTimer);
  });

  const tabs: { value: Tab; label: string }[] = [
    { value: 'preview', label: 'Preview' },
    { value: 'tsx', label: 'TSX' },
    { value: 'css', label: 'CSS' },
    { value: 'warnings', label: 'Warnings' },
  ];

  // Tab inserts two spaces instead of leaving the editor. After Esc, the
  // next Tab leaves it, so the keyboard is never trapped.
  let released = false;

  function indent(event: KeyboardEvent & { currentTarget: HTMLTextAreaElement }) {
    if (event.key === 'Escape') {
      released = true;
      return;
    }
    if (event.key !== 'Tab' || event.shiftKey || released) {
      released = false;
      return;
    }
    event.preventDefault();
    const editor = event.currentTarget;
    const { selectionStart, selectionEnd } = editor;
    editor.setRangeText('  ', selectionStart, selectionEnd, 'end');
    source = editor.value;
  }
</script>

<style>
  main {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: calc(100vh - var(--header-height));
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  /* Terracotta renders the picker and the tabs, so they are not scoped. */
  .toolbar :global(.picker) {
    position: relative;
  }

  .toolbar :global(.picker-button) {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
    min-width: 12rem;
    height: 2rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    font: inherit;
    font-size: var(--step--1);
    color: inherit;
    background: var(--panel);
    cursor: pointer;
  }

  .toolbar :global(.picker-button:hover) {
    border-color: var(--border-strong);
  }

  @media (pointer: coarse) {
    .toolbar :global(.picker-button) {
      height: 2.75rem;
    }
  }

  .toolbar :global(.picker-options) {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    z-index: 20;
    min-width: 100%;
    max-height: 20rem;
    overflow-y: auto;
    margin: 0;
    padding: var(--space-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    list-style: none;
    background: var(--bg-raised);
    box-shadow: 0 8px 24px var(--shadow);
  }

  /* 8px menu, 4px padding, so 4px options. */
  .toolbar :global(.picker-option) {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-xs);
    white-space: nowrap;
    cursor: pointer;
  }

  .toolbar :global(.picker-option[tc-active]) {
    background: var(--border);
  }

  .toolbar :global(.picker-option[tc-selected]) {
    font-weight: 600;
    color: var(--accent);
  }

  .hint {
    margin-left: auto;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 0;
  }

  .editor {
    position: relative;
    min-height: 0;
    border-right: 1px solid var(--border);
    background: var(--bg);
  }

  /* The textarea is transparent over the highlighted copy, so the pane
     shows the focus ring for it. */
  .editor:has(textarea:focus-visible) {
    outline: 2px solid var(--accent-strong);
    outline-offset: -2px;
  }

  .keys {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 1;
    display: flex;
    gap: var(--space-1);
    align-items: center;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--bg-raised);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--exit) var(--ease-in);
  }

  .editor:has(textarea:focus-visible) .keys {
    opacity: 1;
    transition: opacity var(--enter) var(--ease-out);
  }

  /* The textarea and the highlighted copy under it share their layout. */
  textarea,
  .backdrop :global(pre) {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: pre;
    tab-size: 2;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* The frame scrolls with the textarea, so the copy must not scroll itself. */
  .backdrop :global(pre) {
    width: max-content;
    min-width: 100%;
    min-height: 100%;
    overflow: visible;
    border-radius: 0;
    background: none;
  }

  textarea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    color: transparent;
    caret-color: var(--text);
    background: none;
    resize: none;
    /* The editor pane draws the ring; see .editor:has(). */
    outline: none;
  }

  .panes > :global(.output) {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
    background: var(--bg-raised);
  }

  .panes :global(.tabs) {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }

  .panes :global(.tab) {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border: none;
    border-bottom: 2px solid transparent;
    font: inherit;
    color: var(--muted);
    background: none;
    cursor: pointer;
  }

  .panes :global(.tab:hover) {
    color: var(--text);
  }

  .panes :global(.tab[tc-selected]) {
    border-bottom-color: var(--accent);
    color: var(--text);
  }

  .panes :global(.tab:focus-visible) {
    outline-offset: -2px;
  }

  @media (pointer: coarse) {
    .panes :global(.tab) {
      min-height: 2.75rem;
    }
  }

  /* An error replaces the panels until the code compiles. */
  .panes :global(.failed > [role='tabpanel']) {
    display: none;
  }

  pre {
    overflow: auto;
    margin: 0;
    padding: var(--space-4) var(--space-5);
    line-height: 1.5;
  }

  .code {
    height: 100%;
    overflow: auto;
  }

  .code :global(pre.twinkleplop) {
    min-height: 100%;
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border: none;
    border-radius: 0;
    overflow: visible;
    background: none;
  }

  .panes :global(.panel) {
    min-height: 0;
    overflow: auto;
  }

  /* A panel that stays mounted is only shown with its tab. */
  .panes :global(.panel:not([tc-selected])) {
    display: none;
  }

  .panes :global(.preview) {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* The status and errors cover the top of the frame, so it never moves. */
  .overlay {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    max-height: 100%;
    overflow: auto;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border);
  }

  iframe {
    flex: 1;
    width: 100%;
    border: none;
    background: white;
  }

  .status {
    margin: 0;
    padding: var(--space-2) var(--space-5);
    color: var(--muted);
  }

  .error {
    color: var(--caution);
    white-space: pre-wrap;
  }

  .warnings {
    margin: 0;
    padding: var(--space-4) var(--space-5) var(--space-4) var(--space-7);
  }

  .warnings code {
    color: var(--muted);
  }

  .count {
    padding: 0 var(--space-2);
    border-radius: 999px;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--accent-text);
    background: var(--accent);
  }

  /* The toast slides up from the bottom and back down; it can turn mid-way. */
  .toast {
    position: fixed;
    bottom: var(--space-5);
    left: 50%;
    z-index: 30;
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    background: var(--bg-raised);
    box-shadow: 0 12px 32px -8px var(--shadow);
    opacity: 0;
    transform: translate(-50%, 0.75rem);
    pointer-events: none;
    transition:
      opacity var(--exit) var(--ease-in),
      transform var(--exit) var(--ease-in);
  }

  .toast.open {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
    transition:
      opacity var(--enter) var(--ease-out),
      transform var(--enter) var(--ease-out);
  }

  /* 8px toast, 4px padding, so 4px corners on the button. */
  .toast .button {
    min-height: 2rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-xs);
    font-size: var(--step--1);
  }

  @media (prefers-reduced-motion: reduce) {
    .toast {
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 48rem) {
    main {
      height: auto;
    }

    .panes {
      grid-template-columns: minmax(0, 1fr);
    }

    .editor {
      height: 24rem;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .hint {
      display: none;
    }
  }
</style>

<main>
  <div class="toolbar">
    <Listbox class="picker" value=selected onSelectChange=load defaultOpen=false>
      <ListboxButton class="picker-button" aria-label="Example">
        <span>{selected ?? 'Edited example'}</span>
        <Icon name="chevron-down" />
      </ListboxButton>
      <ListboxOptions class="picker-options">
        #for (example of examples) {
          <ListboxOption class="picker-option" value=example.name>{example.name}</ListboxOption>
        }
      </ListboxOptions>
    </Listbox>
    <CopyButton text=(() => location.href) label="Copy link to this code" caption="Copy link" />
    <span class="hint">The compiler runs in your browser.</span>
  </div>

  <div class="panes">
    <div class="editor">
      <div class="backdrop" ref=backdrop aria-hidden="true" innerHTML=sourceHtml />
      <textarea
        aria-label="Source"
        spellcheck=false
        value=source
        onInput=((event) => (source = event.currentTarget.value))
        onKeyDown=indent
        onScroll=syncScroll
      />
      <span class="keys" aria-hidden="true">
        <kbd class="kbd">Esc</kbd> then <kbd class="kbd">Tab</kbd> to leave
      </span>
    </div>
    <TabGroup
      class={ output: true, failed: !output.ok }
      aria-label="Output"
      horizontal=true
      value=tab
      onChange=((value?: Tab) => {
        if (value) {
          tab = value;
        }
      })
    >
      <TabList class="tabs">
        #for (item of tabs) {
          <OutputTab as="button" type="button" class="tab" value=item.value>
            {item.label}
            #if (item.value === 'warnings' && output.ok && output.warnings.length > 0) {
              <span class="count">{output.ok ? output.warnings.length : 0}</span>
            }
          </OutputTab>
        }
      </TabList>
      #if (!output.ok) {
        <pre class="error">{output.ok ? '' : output.error}</pre>
      }
      <!-- The preview stays mounted, so its frame does not load again. -->
      <TabPanel class="panel preview" value="preview" unmount=false>
        #if (previewError) {
          <div class="overlay"><pre class="error">{previewError}</pre></div>
        } #else if (!builder) {
          <div class="overlay"><p class="status">Loading Solid's compiler…</p></div>
        }
        <!-- A new frame tells the playground when it is ready. -->
        <iframe
          title="Preview"
          src=previewUrl
          ref=((element: HTMLIFrameElement) => {
            frame = element;
            frameReady = false;
          })
        />
      </TabPanel>
      <TabPanel class="panel" value="tsx">
        #if (highlighted) {
          <div class="code" innerHTML=highlighted />
        } #else {
          <pre>{output.ok ? output.code : ''}</pre>
        }
      </TabPanel>
      <TabPanel class="panel" value="css">
        #if (highlighted) {
          <div class="code" innerHTML=highlighted />
        } #else {
          <pre>{output.ok ? output.css || '/* No styles */' : ''}</pre>
        }
      </TabPanel>
      <TabPanel class="panel" value="warnings">
        <ul class="warnings">
          #for (warning of output.ok ? output.warnings : []) {
            <li>{warning.line}:{warning.column} {warning.message} <code>{warning.code}</code></li>
          } #else {
            <li>No warnings.</li>
          }
        </ul>
      </TabPanel>
    </TabGroup>
  </div>

  <div class={ toast: true, open: !!undo } role="status" inert=!undo>
    <span>Loaded {undo?.name ?? ''}. Your edits were replaced.</span>
    <button type="button" class="button" onClick=restore>
      <Icon name="undo" />
      Undo
    </button>
  </div>
</main>
